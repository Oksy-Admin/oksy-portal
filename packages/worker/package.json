{
  "name": "@oksy/worker",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "echo \"worker: typecheck is the lint for now\"",
    "test": "vitest run",
    "start": "node --import ../google/scripts/timing.ts src/runner.ts",
    "once": "node --import ../google/scripts/timing.ts src/runner.ts --once",
    "s1-check": "node scripts/s1-check.ts",
    "s2-check": "node scripts/s2-check.ts",
    "s3-check": "node --import ../google/scripts/timing.ts scripts/run-all-private.ts",
    "run-all-private": "node --import ../google/scripts/timing.ts scripts/run-all-private.ts",
    "snapshot-analyse": "node scripts/snapshot-analyse.ts",
    "golden-fixtures": "node scripts/golden-fixtures.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.3.0",
    "@oksy/google": "workspace:*",
    "@oksy/rules": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  }
}
