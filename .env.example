# Copy to .env.local and fill in. NEVER commit .env.local (it is git-ignored).
# Values are put in by Anoop or Muhammed Ali, never pasted into chat.
# On Vercel and Trigger.dev the same names are set as environment variables in the dashboard.

# Supabase (Project Settings > API Keys: Project URL and the "publishable" key)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only. Never exposed to the browser. Used by the background worker.
SUPABASE_SERVICE_ROLE_KEY=

# Google robot oksy-sheet-reader@oksy-data-cleanse.iam.gserviceaccount.com
# The whole JSON key, base64-encoded on one line. Added after the key rotation (before M3).
GOOGLE_SERVICE_ACCOUNT_KEY_B64=
# Shared Drive ID (or a folder inside it) for Question Sheets, the only place the robot
# may write (D-060). Service accounts have no Drive quota, so a My Drive folder does not work.
GOOGLE_QUESTION_SHEETS_FOLDER_ID=

# Trigger.dev (background worker)
TRIGGER_SECRET_KEY=
